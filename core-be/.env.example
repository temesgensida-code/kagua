# ── Kagua Core Backend — Environment Variables ─────────────────────────────
# Copy this file to .env and fill in your values before running the server.

# ── Database ────────────────────────────────────────────────────────────────
# Unix socket (default on Linux local dev):
DATABASE_URL=postgres://temesgensida@%2Fvar%2Frun%2Fpostgresql/kagua_db
# Or TCP with password:
# DATABASE_URL=postgres://kagua_user:yourpassword@localhost:5432/kagua_db

# ── JWT ─────────────────────────────────────────────────────────────────────
# Generate a secure 256-bit random string: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_USE_OPENSSL_RAND_BASE64_32

# ── Resend (Email) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=noreply@kagua.temesgen.works
FROM_NAME=Kagua

# ── Frontend URL (for email links) ──────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Server ──────────────────────────────────────────────────────────────────
PORT=8080
